# Frontend env template.
#
# --- Development (local split) ---
# Vite dev server (:5173) calling Laravel (:8000):
#   VITE_API_URL=http://localhost:8000
#
# --- Production: single-artifact (Laravel serves the SPA, RECOMMENDED) ---
# Leave VITE_API_URL empty so the app calls the same origin
# (relative /api/* and /sanctum/*). No CORS / mixed-content issues.
#   VITE_API_URL=
#
# --- Production: split (separate static host + API host) ---
# Point at the absolute API origin instead:
#   VITE_API_URL=https://primepower-crm-api-primepower.hostforgeplatforms.com

VITE_API_URL=http://localhost:8000
